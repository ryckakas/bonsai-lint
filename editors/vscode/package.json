{
  "name": "bonsai-lint",
  "displayName": "bonsai \u2014 cognitive complexity for PHP, JS and TS",
  "description": "Flags functions that are hard to read, across PHP, JavaScript and TypeScript. Rust-powered, no runtime required.",
  "version": "0.1.0",
  "publisher": "RicardasKauneckas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryckakas/bonsai-lint.git",
    "directory": "editors/vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "php",
    "javascript",
    "typescript",
    "linter",
    "complexity",
    "cognitive-complexity"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "bonsai",
      "properties": {
        "bonsai.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report cognitive complexity."
        },
        "bonsai.path": {
          "type": "string",
          "default": "",
          "description": "Path to a bonsai binary. Leave empty to use the bundled one, falling back to PATH."
        },
        "bonsai.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "php",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact"
          ],
          "description": "Editor language identifiers to analyse."
        },
        "bonsai.threshold": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "markdownDescription": "Override the threshold for every language. Left unset, the repository's `bonsai.toml` decides, so the editor agrees with CI."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
