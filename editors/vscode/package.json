{
  "name": "bonsai-lint",
  "displayName": "bonsai-lint: multi-language cognitive complexity",
  "description": "Flags functions that are hard to read, in every language bonsai-lint supports. Rust-powered, no runtime required.",
  "version": "0.4.1",
  "publisher": "RicardasKauneckas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryckakas/bonsai-lint.git",
    "directory": "editors/vscode"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "php",
    "javascript",
    "typescript",
    "vue",
    "go",
    "java",
    "python",
    "linter",
    "complexity",
    "cognitive-complexity"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "bonsai-lint",
      "properties": {
        "bonsai-lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report cognitive complexity."
        },
        "bonsai-lint.path": {
          "type": "string",
          "default": "",
          "description": "Path to a bonsai-lint binary. Leave empty to use the bundled one, falling back to PATH."
        },
        "bonsai-lint.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "php",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "vue",
            "go",
            "java",
            "python"
          ],
          "description": "Editor language identifiers to analyse."
        },
        "bonsai-lint.threshold": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "markdownDescription": "Override the threshold for every language. Left unset, the repository's `bonsai-lint.toml` decides, so the editor agrees with CI."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "bonsai-lint": "^0.4.1"
  }
}
